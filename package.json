{
  "name": "korean-learning",
  "version": "0.1.0",
  "private": true,
  "description": "Web application for learning Korean",
  "license": "MIT",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "dev": "next dev",
    "prebuild": "tsx scripts/validate-deployment-env.ts",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "test:coverage": "vitest run --coverage",
    "check:bundles": "tsx scripts/check-bundle-budgets.mts",
    "perf:smoke": "tsx scripts/performance-smoke.mts",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:reset": "supabase db reset",
    "db:seed": "tsx scripts/generate-db-seed.ts",
    "db:types": "supabase gen types typescript --local > src/types/database.ts",
    "test:db": "vitest run --config vitest.db.config.mts",
    "test:rls": "vitest run --config vitest.rls.config.mts"
  },
  "engines": {
    "node": ">=24.15.0 <25",
    "pnpm": "10.34.5"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.2",
    "next": "^16.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "server-only": "^0.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "7.0.0",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "6.0.4",
    "@vitest/coverage-v8": "4.1.10",
    "eslint": "^9.39.2",
    "eslint-config-next": "16.3.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "30.0.1",
    "prettier": "^3.9.6",
    "supabase": "^2.113.0",
    "tsx": "^4.23.11",
    "typescript": "^6.0.3",
    "vitest": "4.1.10"
  }
}
