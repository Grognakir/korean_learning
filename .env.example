# Public (safe for browser / Client Components)
# Local: http://127.0.0.1:54321  |  Remote: https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-or-local-anon-key

# Server-only (never expose to the browser bundle)
# Prefer sb_secret_… from the dashboard; local CLI service_role JWT is accepted in the same slot.
SUPABASE_SECRET_KEY=your-secret-or-local-service-role-key

# Auth redirect placeholders (configure the same values in Supabase Auth URL settings)
# Site URL: http://localhost:3000
# Redirect allow-list:
#   http://localhost:3000/auth/callback
#   http://127.0.0.1:3000/auth/callback
#   https://korean-learning-gray.vercel.app/auth/callback
